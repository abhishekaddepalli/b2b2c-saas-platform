# cPanel / LiteSpeed Root .htaccess
# Serves Compiled Frontend Single-Page App & Routes /api to Laravel Backend Entrypoint

# Force PHP 8.3 LiteSpeed Handler for all API requests and rewrites
SetHandler application/x-httpd-alt-php83___lsphp
AddHandler application/x-httpd-alt-php83___lsphp .php
AddHandler application/x-httpd-ea-php83 .php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Handle Authorization Header for API requests
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Route /api Requests to backend/public/index.php
    RewriteCond %{REQUEST_URI} ^/api/
    RewriteRule ^api/(.*)$ backend/public/index.php [L,QSA]

    # Route /check_pdo.php to backend/public/check_pdo.php
    RewriteCond %{REQUEST_URI} ^/check_pdo.php
    RewriteRule ^check_pdo.php$ backend/public/check_pdo.php [L,QSA]

    # Serve Static Build Files if they exist in frontend/dist/
    RewriteCond %{DOCUMENT_ROOT}/frontend/dist%{REQUEST_URI} -f
    RewriteRule ^(.*)$ frontend/dist/$1 [L]

    # SPA Fallback for UI Routes (/install, /login, /admin, /reseller, etc.)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ frontend/dist/index.html [L]
</IfModule>
